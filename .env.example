# 本文件包含敏感凭据，永远不要提交到版本控制系统。
# 复制一份为 .env 并填入你的真实值。

# 敏感密钥（通过 config.yaml 中的占位符引用，或由 auto.sh 读取）
GH_TOKEN=your_github_personal_access_token
GH_OWNER=your_github_username
GH_REPO_NAME=your_repo_name

CF_ACCOUNT_ID=your_cloudflare_account_id
CF_ACCESS_KEY=your_r2_access_key_id
CF_SECRET_KEY=your_r2_secret_access_key
CF_BUCKET_NAME=your_r2_bucket_name

TG_BOT_TOKEN=your_telegram_bot_token
TG_CHAT_ID=your_telegram_chat_id

MAIL_HOST=smtp.example.com
MAIL_USER=your_email@example.com
MAIL_PASS=your_email_authorization_code
MAIL_TO=your_email@example.com

# 本地代理地址（如 http://127.0.0.1:7890）
LOCAL_PROXY_ADDR=